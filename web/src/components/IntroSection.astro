---
import {FOX_MASCOT} from '../lib/fallbacks'
---

<section class="w-full py-space-3xl bg-surface" id="about">
  <div class="site-wrap">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
      <div class="lg:col-span-7 flex flex-col gap-space-md reveal-on-scroll">
        <div class="inline-flex items-center gap-2">
          <span class="sticker-chip">LA STORIA • Η ΙΔΕΑ</span>
          <span class="text-xs text-outline uppercase tracking-wider font-semibold">EST. ILIOUPOLI ATHENS</span>
        </div>
        <h2 class="font-display text-headline-lg-mobile lg:text-headline-lg text-on-surface font-bold leading-tight text-balance">
          Τρεις φίλες, ένα Spritz bar &amp; η αιώνια ηλιόλουστη διάθεση της Ηλιούπολης.
        </h2>
        <p class="font-title-lg text-title-lg text-primary font-medium italic -mt-2">
          "We built the living room we always dreamed of partying in."
        </p>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          Η Περσόνα γεννήθηκε από τρία κορίτσια που κουράστηκαν από τα συνηθισμένα bars. Θέλαμε ατόφια ιταλική aperitivo
          κουλτούρα: τραγανές focaccia, μυρωδάτα spritz με artisanal bitters, ατελείωτες κουβέντες κάτω από λεμονιές και,
          όσο πέφτει το φως, 80s, 90s και 00s ύμνους που σε κάνουν να σηκώνεσαι από το τραπέζι.
        </p>
        <div
          class="p-space-md bg-surface-container-low rounded-lg shadow-elevation-1 flex items-start gap-space-sm border-l-4 border-primary"
        >
          <span class="material-symbols-outlined text-primary text-3xl">format_quote</span>
          <div class="flex flex-col">
            <span class="font-headline-sm text-headline-sm text-on-surface font-semibold"
              >«Η επόμενη στάση είναι γνωστή.»</span
            >
            <span class="font-body-sm text-body-sm text-outline italic"
              >Next station: Ilioupoli Sun City. Spritz first, questions later.</span
            >
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
          {
            [
              {icon: 'favorite', color: 'text-primary', label: '100% Female Founded'},
              {icon: 'local_pizza', color: 'text-secondary', label: 'Open-Flame Pizzaiolo'},
              {icon: 'graphic_eq', color: 'text-tertiary', label: 'Eclectic DJ Grooves'},
            ].map((chip) => (
              <div class="flex items-center gap-2 bg-surface-container px-space-sm py-2 rounded-lg text-xs font-semibold text-on-surface">
                <span class={`material-symbols-outlined ${chip.color} text-[18px]`}>{chip.icon}</span>
                <span>{chip.label}</span>
              </div>
            ))
          }
          <div class="sticker-chip !bg-primary-fixed !text-on-primary-fixed !border-primary/30 rotate-[3deg]">
            128+ ευτυχισμένες φάτσες στους τοίχους μας
          </div>
        </div>
      </div>

      <!-- Extra padding so stickers can hang outside the card without cropping -->
      <div class="lg:col-span-5 relative reveal-on-scroll pt-5 pb-5 px-2 overflow-visible">
        <div
          class="unbox-card cursor-pointer group relative bg-cardboard rounded-lg p-space-lg shadow-elevation-2 border border-primary/10 overflow-visible select-none"
          id="unboxing-box"
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label="Unbox Persona secrets"
        >
          <div
            class="absolute -top-3 left-8 z-20 bg-primary-fixed text-on-primary-fixed text-[10px] font-bold uppercase tracking-widest px-4 py-1.5 shadow-md -rotate-3 rounded-tl-none rounded-br-2xl border border-primary/10"
            id="tape-banner"
          >
            FRAGILE • SPRITZ INSIDE
          </div>
          <div
            class="absolute -bottom-3 right-5 z-20 bg-surface-dim text-on-surface-variant text-[10px] font-mono tracking-widest px-3 py-1 shadow rotate-2 border border-outline-variant/40"
            id="batch-sticker"
          >
            BATCH #042-ATH
          </div>

          <div
            class="flex items-center justify-between pb-space-sm mb-space-sm bg-surface-container-highest px-3.5 py-2.5 rounded-lg"
          >
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-xl">inventory_2</span>
              <span class="font-label-sticker text-label-sticker text-on-surface tracking-wider uppercase font-bold"
                >UNBOXING PERSONA</span
              >
            </div>
            <span
              class="text-xs bg-primary text-on-primary px-3 py-0.5 rounded-full font-bold shadow-sm transition-colors"
              id="unboxing-badge">Click to Open</span
            >
          </div>

          <!-- Gift present stage -->
          <div class="present-stage relative mx-auto mb-space-md h-40 w-full max-w-[220px]" aria-hidden="true">
            <div class="present-burst" id="present-burst"></div>

            <div class="present-fox" id="present-fox">
              <img
                src={FOX_MASCOT}
                alt=""
                class="w-full h-full object-contain rounded-full bg-tangerine p-1.5 shadow-lg"
                width="88"
                height="88"
              />
            </div>

            <div class="present-box" id="present-box">
              <div class="present-lid" id="present-lid">
                <span class="present-bow"></span>
              </div>
              <div class="present-body">
                <span class="present-ribbon-v"></span>
                <span class="present-ribbon-h"></span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-space-sm mb-space-md">
            <div>
              <span class="font-headline-sm text-headline-sm text-on-surface block leading-tight">Οι 3 της Περσόνας</span>
              <span class="text-xs text-outline uppercase tracking-wider">Eleni, Maria, Christina</span>
            </div>
          </div>

          <div class="unbox-secrets font-body-sm text-body-sm text-on-surface-variant" id="unboxing-content">
            <div class="space-y-3">
              <div class="p-3 bg-surface-container rounded-lg secret-card" style="--delay: 0ms">
                <strong class="text-primary block font-semibold text-xs uppercase tracking-wider"
                  >01. Το μυστικό του Spritz:</strong
                >
                <span class="mt-0.5 block"
                  >Χειροποίητο σιρόπι περγαμόντο και prosecco από μικρό οινοποιείο στο Veneto.</span
                >
              </div>
              <div class="p-3 bg-surface-container rounded-lg secret-card" style="--delay: 80ms">
                <strong class="text-secondary block font-semibold text-xs uppercase tracking-wider"
                  >02. Γιατί Αλεπού; (The Mascot):</strong
                >
                <span class="mt-0.5 block"
                  >Γιατί είναι παιχνιδιάρα, απρόβλεπτη και ξέρει πού κρύβεται το καλύτερο πάρτι στην πόλη!</span
                >
              </div>
              <div class="p-3 bg-surface-container rounded-lg secret-card" style="--delay: 160ms">
                <strong class="text-tertiary block font-semibold text-xs uppercase tracking-wider"
                  >03. Vinyl &amp; 00s Anthems:</strong
                >
                <span class="mt-0.5 block">Από Raffaella Carrà μέχρι Gwen Stefani &amp; Nu-Disco edits.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .unbox-card.is-open {
    box-shadow:
      0 16px 36px -8px rgba(26, 20, 18, 0.16),
      0 0 0 3px rgba(232, 92, 31, 0.35);
  }

  .unbox-secrets {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition:
      max-height 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .unbox-card.is-open .unbox-secrets {
    max-height: 420px;
    opacity: 1;
    transform: translateY(0);
  }

  .unbox-card.is-open .secret-card {
    animation: secret-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes secret-pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .present-stage {
    perspective: 700px;
  }

  .present-box {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 132px;
    height: 92px;
    transform: translateX(-50%);
    z-index: 2;
  }

  .present-body {
    position: absolute;
    inset: 28px 0 0;
    border-radius: 10px 10px 14px 14px;
    background: linear-gradient(160deg, #f2a06a 0%, #e85c1f 55%, #cc4907 100%);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.25),
      0 10px 20px -8px rgba(232, 92, 31, 0.55);
    overflow: hidden;
  }

  .present-ribbon-v,
  .present-ribbon-h {
    position: absolute;
    background: linear-gradient(180deg, #ff7ab8 0%, #e8246c 100%);
  }

  .present-ribbon-v {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 18px;
    transform: translateX(-50%);
  }

  .present-ribbon-h {
    left: 0;
    right: 0;
    top: 42%;
    height: 18px;
  }

  .present-lid {
    position: absolute;
    left: -6px;
    right: -6px;
    top: 0;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(180deg, #ffb08a 0%, #e85c1f 100%);
    box-shadow: 0 6px 14px -6px rgba(26, 20, 18, 0.35);
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.2, 1.2);
    z-index: 4;
  }

  .present-bow {
    position: absolute;
    left: 50%;
    top: -10px;
    width: 28px;
    height: 28px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff9dcb, #e8246c 70%);
    box-shadow: 0 0 0 4px rgba(232, 36, 108, 0.2);
  }

  .present-fox {
    position: absolute;
    left: 50%;
    bottom: 46px;
    width: 88px;
    height: 88px;
    transform: translateX(-50%) translateY(42px) scale(0.55);
    opacity: 0;
    z-index: 3;
    transition:
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
      opacity 0.35s ease 0.1s;
  }

  .present-burst {
    position: absolute;
    left: 50%;
    top: 28%;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%) scale(0);
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.95), rgba(232, 36, 108, 0));
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .unbox-card.is-open .present-lid {
    transform: rotate(-48deg) translate(-8px, -18px);
  }

  .unbox-card.is-open .present-fox {
    opacity: 1;
    transform: translateX(-50%) translateY(-18px) scale(1) rotate(-6deg);
    animation: fox-bounce 1.1s ease-in-out 0.55s infinite;
  }

  .unbox-card.is-open .present-burst {
    animation: burst-pop 0.7s ease-out 0.12s both;
  }

  .unbox-card.is-open #tape-banner {
    transform: translateY(-14px) rotate(-12deg) scale(1.05);
    background: #e8246c;
    color: #fff;
  }

  .unbox-card.is-open #batch-sticker {
    transform: rotate(8deg) translateY(4px);
  }

  @keyframes fox-bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(-18px) scale(1) rotate(-6deg);
    }
    50% {
      transform: translateX(-50%) translateY(-28px) scale(1.04) rotate(4deg);
    }
  }

  @keyframes burst-pop {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(0.2);
      box-shadow:
        0 0 0 0 rgba(232, 92, 31, 0.5),
        0 0 0 0 rgba(232, 36, 108, 0.35);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(9);
      box-shadow:
        0 0 0 40px rgba(232, 92, 31, 0),
        0 0 0 70px rgba(232, 36, 108, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .present-lid,
    .present-fox,
    .unbox-secrets,
    .secret-card {
      transition: none !important;
      animation: none !important;
    }
    .unbox-card.is-open .present-fox {
      opacity: 1;
      transform: translateX(-50%) translateY(-18px) scale(1);
    }
  }
</style>

<script>
  const unbox = document.getElementById('unboxing-box')
  const badge = document.getElementById('unboxing-badge')
  let isUnboxed = false
  let animating = false

  function setOpen(next) {
    if (!unbox || animating) return
    isUnboxed = next
    animating = true
    unbox.setAttribute('aria-expanded', String(isUnboxed))
    unbox.classList.toggle('is-open', isUnboxed)

    if (badge) {
      badge.textContent = isUnboxed ? 'Unboxed!' : 'Click to Open'
      badge.classList.toggle('bg-secondary', isUnboxed)
      badge.classList.toggle('bg-primary', !isUnboxed)
    }

    window.setTimeout(() => {
      animating = false
    }, 700)
  }

  function toggle() {
    setOpen(!isUnboxed)
  }

  unbox?.addEventListener('click', toggle)
  unbox?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault()
      toggle()
    }
  })
</script>
