---
import {FOX_MASCOT, siteDefaults} from '../lib/fallbacks'
---

<section class="w-full py-space-3xl bg-surface relative overflow-hidden" id="booking-section">
  <div class="max-w-[1000px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin-desktop relative z-10">
    <div
      class="bg-surface-container-lowest rounded-xl p-space-xl lg:p-space-2xl shadow-floating flex flex-col items-center text-center relative border border-primary/10 reveal-on-scroll"
    >
      <div class="w-20 h-20 rounded-full bg-primary-fixed p-1 shadow-lg -mt-14 mb-space-md relative">
        <img
          src={FOX_MASCOT}
          alt=""
          class="w-full h-full object-contain rounded-full bg-tangerine p-2"
          width="80"
          height="80"
        />
        <span
          class="absolute -top-1 -right-1 bg-secondary text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold shadow-xs rounded-tl-none"
          >Spritz!</span
        >
      </div>
      <span class="font-label-sticker text-label-sticker uppercase tracking-widest text-primary font-bold mb-1">
        RESERVATIONS • ΚΡΑΤΗΣΕΙΣ
      </span>
      <h2 class="font-display text-headline-lg-mobile lg:text-headline-lg text-on-surface font-bold leading-tight">
        Κλείσε το τραπέζι σου στην Περσόνα
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-lg mt-2">
        Για παρέες, γενέθλια, aperitivo dates ή απλά για spritz μετά τη δουλειά. Συμπλήρωσε τα στοιχεία σου και θα
        επιβεβαιώσουμε άμεσα μέσω SMS/WhatsApp!
      </p>

      <form class="w-full max-w-xl mt-space-xl grid grid-cols-1 sm:grid-cols-2 gap-space-sm text-left" id="reservation-form">
        <div class="flex flex-col gap-1">
          <label class="text-xs font-semibold text-on-surface uppercase tracking-wider" for="res-name"
            >Ονοματεπώνυμο / Name</label
          >
          <input class="form-input" id="res-name" name="name" placeholder="π.χ. Ελένη Παπαδοπούλου" required type="text" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-semibold text-on-surface uppercase tracking-wider" for="res-phone"
            >Τηλέφωνο / Phone</label
          >
          <input class="form-input" id="res-phone" name="phone" placeholder="69XXXXXXXX" required type="tel" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-semibold text-on-surface uppercase tracking-wider" for="res-date"
            >Ημερομηνία / Date</label
          >
          <input class="form-input" id="res-date" name="date" required type="date" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-semibold text-on-surface uppercase tracking-wider" for="res-guests"
            >Άτομα / Guests</label
          >
          <select class="form-input" id="res-guests" name="guests">
            <option>2 άτομα (Spritz Date)</option>
            <option>3–4 άτομα (Small Crew)</option>
            <option>5–8 άτομα (Birthday / Aperitivo)</option>
            <option>9+ άτομα (Big Party!)</option>
          </select>
        </div>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-semibold text-on-surface uppercase tracking-wider" for="res-notes"
            >Σημειώσεις / Notes (Optional)</label
          >
          <input
            class="form-input"
            id="res-notes"
            name="notes"
            placeholder="π.χ. Προτίμηση κήπου, DJ night τραπέζι κτλ."
            type="text"
          />
        </div>
        <div class="sm:col-span-2 mt-space-sm">
          <button class="btn-aperitivo w-full group/btn" type="submit">
            <img
              src={FOX_MASCOT}
              alt=""
              class="w-5 h-5 object-contain transition-transform duration-300 group-hover/btn:rotate-12"
              width="20"
              height="20"
            />
            <span>Ολοκλήρωση Κράτησης / Confirm Table</span>
          </button>
        </div>
        <p class="sm:col-span-2 text-sm text-outline hidden" id="reservation-status" role="status" aria-live="polite"></p>
      </form>

      <div class="mt-space-lg flex flex-wrap items-center justify-center gap-space-md text-xs text-outline font-medium">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">call</span>
          <span>{siteDefaults.phone}</span>
        </span>
        <span>•</span>
        <a class="hover:text-primary transition-colors flex items-center gap-1" href={siteDefaults.instagram} target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-sm">photo_camera</span>
          <span>{siteDefaults.instagramHandle}</span>
        </a>
        <span>•</span>
        <a class="hover:text-secondary transition-colors flex items-center gap-1" href={siteDefaults.tiktok} target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-sm">videocam</span>
          <span>{siteDefaults.tiktokHandle}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('reservation-form') as HTMLFormElement | null
  const status = document.getElementById('reservation-status')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!form || !status) return

    status.classList.remove('hidden', 'text-primary', 'text-error')
    status.textContent = 'Στέλνουμε την κράτηση…'

    const data = Object.fromEntries(new FormData(form).entries())

    try {
      const res = await fetch('/api/reservation/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', Accept: 'application/json'},
        body: JSON.stringify(data),
      })
      const json = (await res.json()) as {success?: boolean; error?: string}

      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Αποτυχία αποστολής')
      }

      status.classList.add('text-primary')
      status.textContent = 'Ευχαριστούμε! Η κράτησή σου καταχωρήθηκε στην Περσόνα!'
      form.reset()
    } catch (err) {
      status.classList.add('text-error')
      status.textContent =
        err instanceof Error ? err.message : 'Κάτι πήγε στραβά. Δοκίμασε ξανά ή κάλεσέ μας.'
    }
  })
</script>
