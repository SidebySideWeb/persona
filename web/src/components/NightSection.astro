---
import {FOX_MASCOT, nightImages, siteDefaults} from '../lib/fallbacks'

const tracks = [
  {
    title: 'Cyndi Lauper • Girls Just Wanna Have Fun',
    artist: 'Paris Music',
    era: '80s classic',
    url: 'https://soundcloud.com/parismusicmusic/girls-just-wanna-have-fun-5',
  },
  {
    title: '2 Unlimited • No Limit',
    artist: 'DJ Lantern',
    era: '90s techno',
    url: 'https://soundcloud.com/cafedelantaarn/2-unlimited-no-limit-1993',
  },
  {
    title: 'Corona • Rhythm Of The Night',
    artist: 'DJ Lantern',
    era: '90s dance',
    url: 'https://soundcloud.com/cafedelantaarn/corona-rhythm-of-the-nights',
  },
  {
    title: 'Daft Punk • One More Time',
    artist: 'Daft Punk',
    era: '00s house',
    url: 'https://soundcloud.com/daftpunkofficialmusic/one-more-time-2',
  },
]

const firstTrack = tracks[0]
const widgetSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(firstTrack.url)}&color=%23E8246C&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false&visual=false`
---

<section class="w-full py-space-3xl bg-night text-inverse-on-surface relative overflow-hidden" id="dj-section">
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-secondary-container opacity-45 rounded-full blur-[110px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-tertiary opacity-55 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="site-wrap relative z-10">
    <div class="flex flex-col items-center text-center mb-space-2xl reveal-on-scroll">
      <div class="nightlife-badge mb-3 gap-2 shadow-[0_0_24px_rgba(232,36,108,0.75)]">
        <span class="material-symbols-outlined text-[16px]">album</span>
        <span>NIGHTFALL MODE • DJ SESSIONS</span>
      </div>
      <h2 class="font-display text-headline-lg-mobile lg:text-headline-lg text-white font-bold leading-tight text-balance">
        Από τον ηλιόλουστο κήπο στα neon grooves
      </h2>
      <p class="font-body-lg text-body-lg text-surface-variant max-w-2xl mt-2">
        Την ημέρα: ριγέ ξαπλώστρες, λεμονιές και δροσερά spritz. Το βράδυ: η ένταση ανεβαίνει με resident DJs που παίζουν
        80s, 90s, 00s και Italo Disco.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg mb-space-2xl">
      <div class="relative rounded-lg overflow-hidden shadow-2xl group min-h-[380px] flex flex-col justify-end p-space-lg">
        <div
          class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
          style={`background-image: url('${nightImages.garden}')`}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
        <div class="relative z-10 flex flex-col">
          <span class="bg-primary text-on-primary px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider self-start mb-2 shadow"
            >18:00 – 21:00 • The Garden</span
          >
          <h3 class="font-headline-md text-headline-md text-white font-bold">Golden Hour Spritzeria</h3>
          <p class="font-body-sm text-body-sm text-surface-variant mt-1">
            Χαλαρές συζητήσεις, τραπεζάκια έξω, aperitivo bites και το αθηναϊκό ηλιοβασίλεμα να λούζει την πλατεία.
          </p>
        </div>
      </div>
      <div class="relative rounded-lg overflow-hidden shadow-2xl group min-h-[380px] flex flex-col justify-end p-space-lg">
        <div
          class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
          style={`background-image: url('${nightImages.club}')`}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
        <div class="relative z-10 flex flex-col">
          <span
            class="bg-tertiary-container text-on-tertiary-container px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider self-start mb-2 shadow"
            >21:30 – Late • DJ Sets</span
          >
          <h3 class="font-headline-md text-headline-md text-white font-bold">Electric 90s &amp; 00s Nostalgia</h3>
          <p class="font-body-sm text-body-sm text-surface-variant mt-1">
            Ανεβασμένες εντάσεις, Disco House, Eurodance bops και τα cocktail shakers να δίνουν τον ρυθμό.
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
      <div class="lg:col-span-7 rounded-lg p-space-lg shadow-electric-night flex flex-col justify-between border border-white/10">
        <div>
          <div class="flex items-center justify-between pb-space-sm mb-space-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-2xl">graphic_eq</span>
              <span class="font-label-sticker text-label-sticker uppercase tracking-widest text-secondary-fixed"
                >PERSONA MIXTAPE VOL. 1</span
              >
            </div>
            <div
              class="flex items-end gap-1 h-5 px-2 bg-black/40 rounded-full py-1"
              id="mixtape-eq"
              data-playing="false"
            >
              <span class="w-1 bg-secondary rounded-full eq-1"></span>
              <span class="w-1 bg-primary rounded-full eq-2"></span>
              <span class="w-1 bg-amber-400 rounded-full eq-3"></span>
              <span class="w-1 bg-secondary rounded-full eq-4"></span>
            </div>
          </div>

          <div
            class="flex items-center gap-space-sm p-space-sm bg-black/50 rounded-lg mb-space-md border border-white/5 cursor-pointer hover:bg-black/70 transition-colors"
            id="vinyl-player-btn"
            role="button"
            tabindex="0"
            aria-pressed="false"
            aria-label="Play or pause mixtape"
          >
            <div class="relative w-12 h-12 shrink-0">
              <div
                class="w-12 h-12 rounded-full bg-neutral-900 border-2 border-neutral-700 flex items-center justify-center shadow-lg"
                id="vinyl-disc"
                style="animation-play-state: paused;"
              >
                <div class="w-4 h-4 rounded-full bg-secondary flex items-center justify-center">
                  <div class="w-1 h-1 rounded-full bg-black"></div>
                </div>
              </div>
            </div>
            <div class="flex flex-col min-w-0 flex-1">
              <span class="text-white font-bold text-sm truncate" id="now-playing-title">{firstTrack.title}</span>
              <span class="text-xs text-secondary-fixed-dim" id="now-playing-meta">{firstTrack.artist} • SoundCloud</span>
            </div>
            <span class="text-xs font-mono text-outline-variant pr-2 tabular-nums" id="now-playing-time">0:00 / 0:00</span>
          </div>

          <div class="space-y-2 text-xs" id="mixtape-tracklist">
            {
              tracks.map((track, i) => (
                <button
                  type="button"
                  class="mixtape-track w-full flex items-center justify-between p-2.5 rounded-lg bg-white/5 hover:bg-white/15 transition-all text-left"
                  data-track-url={track.url}
                  data-track-title={track.title}
                  data-track-artist={track.artist}
                  data-track-index={String(i)}
                  aria-current={i === 0 ? 'true' : 'false'}
                >
                  <span class="text-white flex items-center gap-2 min-w-0">
                    <span class="material-symbols-outlined text-xs text-secondary track-icon">play_arrow</span>
                    <span class="truncate">
                      {String(i + 1).padStart(2, '0')}. {track.title}
                    </span>
                  </span>
                  <span class="text-secondary-fixed-dim font-mono shrink-0 ml-2">{track.era}</span>
                </button>
              ))
            }
          </div>
        </div>

        <iframe
          id="sc-widget"
          title="Persona SoundCloud mixtape"
          allow="autoplay"
          loading="lazy"
          class="sr-only"
          width="100%"
          height="0"
          scrolling="no"
          frameborder="no"
          src={widgetSrc}
        ></iframe>
      </div>

      <div
        class="lg:col-span-5 bg-gradient-electric-mezzanotte/90 rounded-lg p-space-lg shadow-electric flex flex-col justify-between relative overflow-hidden border border-white/10 group"
      >
        <div class="absolute -right-6 -bottom-6 w-36 h-36 opacity-20">
          <img src={FOX_MASCOT} alt="" class="w-full h-full object-contain" width="144" height="144" />
        </div>
        <div class="relative z-10">
          <span class="nightlife-badge mb-3">OPEN CALL</span>
          <h3 class="font-headline-md text-headline-md text-white font-bold leading-tight">
            DJ Open Call — Spin with us!
          </h3>
          <p class="font-body-sm text-body-sm text-surface-variant mt-2 leading-relaxed">
            Είσαι DJ και αγαπάς τα 80s, 90s, 00s, Disco &amp; Funky House; Στείλε μας το mixtape σου στο Instagram DM και
            έλα να παίξεις στο booth της Περσόνας.
          </p>
        </div>
        <div class="relative z-10 mt-space-md">
          <a
            class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-full bg-secondary text-white font-label-lg text-label-lg uppercase tracking-wider hover:bg-secondary-container transition-all shadow-electric-badge hover:scale-105 active:scale-95"
            href={siteDefaults.instagram}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Στείλε μας DM {siteDefaults.instagramHandle}</span>
            <span class="material-symbols-outlined text-sm">send</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #vinyl-disc.is-spinning {
    animation: spin-vinyl 4s linear infinite;
  }

  #mixtape-eq[data-playing='false'] .eq-1,
  #mixtape-eq[data-playing='false'] .eq-2,
  #mixtape-eq[data-playing='false'] .eq-3,
  #mixtape-eq[data-playing='false'] .eq-4 {
    animation: none;
    height: 4px;
  }

  .mixtape-track[aria-current='true'] {
    background-color: rgba(232, 36, 108, 0.22);
    box-shadow: inset 0 0 0 1px rgba(232, 36, 108, 0.45);
  }
</style>

<script is:inline>
  ;(function () {
    function formatTime(ms) {
      var total = Math.max(0, Math.floor((ms || 0) / 1000))
      var m = Math.floor(total / 60)
      var s = String(total % 60).padStart(2, '0')
      return m + ':' + s
    }

    function bootMixtape() {
      var iframe = document.getElementById('sc-widget')
      var vinylBtn = document.getElementById('vinyl-player-btn')
      var vinylDisc = document.getElementById('vinyl-disc')
      var titleEl = document.getElementById('now-playing-title')
      var metaEl = document.getElementById('now-playing-meta')
      var timeEl = document.getElementById('now-playing-time')
      var eq = document.getElementById('mixtape-eq')
      var trackButtons = Array.prototype.slice.call(document.querySelectorAll('.mixtape-track'))

      if (!iframe || !vinylBtn || !window.SC || !window.SC.Widget) return

      var widget = window.SC.Widget(iframe)
      var currentIndex = 0
      var duration = 0

      function setPlayingUI(playing) {
        vinylBtn.setAttribute('aria-pressed', String(playing))
        if (vinylDisc) vinylDisc.classList.toggle('is-spinning', playing)
        if (eq) eq.setAttribute('data-playing', String(playing))
        trackButtons.forEach(function (btn, i) {
          var icon = btn.querySelector('.track-icon')
          if (icon) icon.textContent = playing && i === currentIndex ? 'pause' : 'play_arrow'
        })
      }

      function setActiveTrack(index) {
        currentIndex = index
        trackButtons.forEach(function (btn, i) {
          btn.setAttribute('aria-current', i === index ? 'true' : 'false')
        })
        var btn = trackButtons[index]
        if (btn && titleEl && metaEl) {
          titleEl.textContent = btn.getAttribute('data-track-title') || ''
          metaEl.textContent = (btn.getAttribute('data-track-artist') || '') + ' • SoundCloud'
        }
      }

      function loadTrack(index, autoPlay) {
        var btn = trackButtons[index]
        var url = btn && btn.getAttribute('data-track-url')
        if (!url) return
        setActiveTrack(index)
        widget.load(url, {
          auto_play: !!autoPlay,
          show_artwork: false,
          show_comments: false,
          buying: false,
          liking: false,
          download: false,
          sharing: false,
          show_playcount: false,
          show_user: false,
          hide_related: true,
        })
      }

      widget.bind(window.SC.Widget.Events.READY, function () {
        widget.getDuration(function (d) {
          duration = d || 0
          if (timeEl) timeEl.textContent = '0:00 / ' + formatTime(duration)
        })
      })

      widget.bind(window.SC.Widget.Events.PLAY, function () {
        setPlayingUI(true)
      })
      widget.bind(window.SC.Widget.Events.PAUSE, function () {
        setPlayingUI(false)
      })
      widget.bind(window.SC.Widget.Events.FINISH, function () {
        loadTrack((currentIndex + 1) % trackButtons.length, true)
      })
      widget.bind(window.SC.Widget.Events.PLAY_PROGRESS, function (data) {
        if (!timeEl) return
        widget.getDuration(function (d) {
          duration = d || duration
          timeEl.textContent = formatTime(data.currentPosition) + ' / ' + formatTime(duration)
        })
      })

      vinylBtn.addEventListener('click', function () {
        widget.toggle()
      })
      vinylBtn.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          widget.toggle()
        }
      })

      trackButtons.forEach(function (btn, index) {
        btn.addEventListener('click', function () {
          if (index === currentIndex) {
            widget.toggle()
            return
          }
          loadTrack(index, true)
        })
      })

      setActiveTrack(0)
      setPlayingUI(false)
    }

    function loadApiThenBoot() {
      if (window.SC && window.SC.Widget) {
        bootMixtape()
        return
      }
      var existing = document.querySelector('script[data-sc-widget-api]')
      if (existing) {
        existing.addEventListener('load', bootMixtape)
        return
      }
      var s = document.createElement('script')
      s.src = 'https://w.soundcloud.com/player/api.js'
      s.async = true
      s.setAttribute('data-sc-widget-api', 'true')
      s.onload = bootMixtape
      document.head.appendChild(s)
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadApiThenBoot)
    } else {
      loadApiThenBoot()
    }
  })()
</script>
