---
import {FOX_MASCOT, siteDefaults} from '../lib/fallbacks'

const marqueeItems = [
  '90s–00s',
  'ITALIAN',
  'SPRITZ',
  'GIRLS JUST WANNA HAVE SPRITZ',
  'APEROL HOUR',
  'ILIOUPOLI SUN CITY',
  'NATURAL BUBBLES',
  'WOOD-FIRED PIZZAIOLO',
]
---

<section class="relative w-full overflow-hidden bg-gradient-aperitivo-dusk text-on-primary pt-[7.5rem] pb-16 lg:pb-24">
  <div class="absolute inset-0 pointer-events-none opacity-25">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <radialGradient cx="50%" cy="40%" id="sunburst" r="60%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85"></stop>
          <stop offset="100%" stop-color="#cc4907" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <rect fill="url(#sunburst)" height="100%" width="100%"></rect>
    </svg>
  </div>

  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    {
      [
        {w: 22, left: '12%', delay: '0.2s', dur: '6s'},
        {w: 14, left: '24%', delay: '1.4s', dur: '5.2s'},
        {w: 32, left: '38%', delay: '0.7s', dur: '7.5s'},
        {w: 18, left: '62%', delay: '2.1s', dur: '5.8s'},
        {w: 26, left: '78%', delay: '1.1s', dur: '6.8s'},
        {w: 16, left: '88%', delay: '2.8s', dur: '4.9s'},
      ].map((b) => (
        <span
          class="absolute rounded-full border border-white/40 bg-white/20 backdrop-blur-sm"
          style={`width:${b.w}px;height:${b.w}px;left:${b.left};bottom:-30px;animation:float-bubble ${b.dur} infinite linear ${b.delay};`}
        />
      ))
    }
  </div>

  <div class="site-wrap relative z-10 flex flex-col items-center text-center">
    <div
      class="inline-flex items-center gap-space-xs bg-surface-container-lowest/95 text-on-surface px-space-md py-space-2xs rounded-full shadow-md -rotate-1 hover:rotate-0 hover:scale-105 transition-all duration-300 mb-space-lg"
    >
      <img
        src={FOX_MASCOT}
        alt=""
        class="w-7 h-7 object-contain rounded-full bg-primary-fixed p-0.5 animate-bounce"
        style="animation-duration: 2.2s;"
        width="28"
        height="28"
      />
      <span class="font-label-sticker text-label-sticker tracking-widest text-primary uppercase"
        >ILIOUPOLI • SUN CITY • ATHENS</span
      >
    </div>

    <div class="flex flex-col items-center max-w-4xl mx-auto reveal-on-scroll">
      <span class="font-label-lg text-label-lg tracking-[0.25em] text-primary-fixed uppercase mb-2">
        90s–00s • ΙΤΑΛΙΚΑ • SPRITZ BAR
      </span>
      <h1 class="font-display text-[44px] leading-[48px] tracking-[-0.02em] md:text-display-hero uppercase text-on-primary drop-shadow-md mb-2">
        {siteDefaults.brandName}
      </h1>
      <p class="font-display italic text-headline-lg-mobile md:text-headline-lg font-normal tracking-wide text-primary-fixed-dim -mt-1 mb-space-md">
        Spritzeria
      </p>
      <p class="font-body-lg text-body-lg text-primary-fixed max-w-xl mx-auto font-medium leading-relaxed">
        “Girls just wanna have Spritz.” Ένα φωτεινό, αυθεντικό aperitivo καταφύγιο στην Ηλιούπολη που το βράδυ ανάβει τα decks.
      </p>
      <span class="font-body-sm text-body-sm text-primary-fixed/80 italic mt-1">
        Sun-drenched Mediterranean bubbles turning into eclectic vinyl beats.
      </span>
    </div>

    <div class="relative my-space-lg flex items-center justify-center reveal-on-scroll">
      <div class="absolute w-56 h-56 sm:w-72 sm:h-72 bg-amber-400 rounded-full pointer-events-none animate-pulse-glow"></div>
      <div class="w-48 h-48 sm:w-60 sm:h-60 bg-surface-container-lowest rounded-full p-3.5 shadow-2xl relative animate-float-fox">
        <div class="w-full h-full rounded-full overflow-hidden flex items-center justify-center p-2.5 bg-tangerine shadow-inner">
          <img
            src={FOX_MASCOT}
            alt="Persona Spritzeria Fox Mascot"
            class="w-full h-full object-contain p-2"
            width="200"
            height="200"
          />
        </div>
        <div
          class="absolute -bottom-2 -right-3 bg-secondary text-on-secondary px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-lg rotate-6"
        >
          EST. 2024
        </div>
        <div
          class="absolute -top-3 -left-4 bg-surface text-on-surface px-3 py-1 rounded shadow-md -rotate-6 font-label-sticker text-[11px] uppercase tracking-wider text-primary rounded-tl-none rounded-br-2xl"
        >
          3 GIRLS &amp; A FOX
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-space-sm w-full sm:w-auto justify-center mt-space-xs reveal-on-scroll">
      <a
        href="#booking-section"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-space-xl py-3.5 rounded-full bg-surface-container-lowest text-primary hover:bg-surface-container-low font-label-lg text-label-lg uppercase tracking-wider shadow-lg hover:shadow-2xl hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span class="material-symbols-outlined text-[20px]">event_seat</span>
        <span>Κράτηση / Reserve a table</span>
      </a>
      <a
        href="#location-section"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-space-xl py-3.5 rounded-full bg-secondary text-on-secondary hover:bg-secondary-container font-label-lg text-label-lg uppercase tracking-wider shadow-lg hover:shadow-[0_8px_30px_rgba(232,36,108,0.5)] hover:-translate-y-1 hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span class="material-symbols-outlined text-[20px]">near_me</span>
        <span>Οδηγίες / Directions</span>
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-space-sm mt-space-lg reveal-on-scroll">
      {['90s', 'Italian', 'Spritz', 'Ilioupoli', 'DJ Nights'].map((tag) => (
        <span class="inline-flex items-center bg-surface/20 backdrop-blur-md px-space-sm py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-white">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex items-center justify-center gap-space-sm mt-space-md reveal-on-scroll">
      <a
        class="inline-flex items-center gap-1.5 bg-surface/20 backdrop-blur-md px-space-sm py-1 rounded-full text-xs font-medium text-white hover:bg-surface/35 transition-all"
        href={siteDefaults.instagram}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span class="material-symbols-outlined text-sm">photo_camera</span>
        <span>{siteDefaults.instagramHandle}</span>
        <span class="bg-surface-container-lowest/30 text-[10px] px-1.5 py-0.5 rounded-full">5.1k</span>
      </a>
      <a
        class="inline-flex items-center gap-1.5 bg-surface/20 backdrop-blur-md px-space-sm py-1 rounded-full text-xs font-medium text-white hover:bg-surface/35 transition-all"
        href={siteDefaults.tiktok}
        rel="noopener noreferrer"
        target="_blank"
      >
        <span class="material-symbols-outlined text-sm">videocam</span>
        <span>{siteDefaults.tiktokHandle}</span>
      </a>
    </div>
  </div>

  <div class="mt-space-2xl w-full bg-surface-container-lowest text-on-surface overflow-hidden py-3 shadow-inner marquee-wrapper cursor-default select-none">
    <div
      class="marquee-track flex whitespace-nowrap gap-6 font-headline-sm text-headline-sm uppercase tracking-wider items-center text-primary font-bold animate-marquee-scroll"
      style="width: max-content;"
    >
      {[...marqueeItems, ...marqueeItems].map((item, i) => (
        <>
          <span>{item}</span>
          <span class="text-secondary">•</span>
          {i % 8 === 5 ? (
            <img src={FOX_MASCOT} alt="" class="w-6 h-6 inline-block object-contain" width="24" height="24" />
          ) : null}
        </>
      ))}
    </div>
  </div>
</section>
